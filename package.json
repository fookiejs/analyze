{
  "name": "@fookiejs/analyze",
  "version": "0.1.8",
  "description": "A dependency-free observability UI for a fookie app: application map, live runs, logs, metrics, traces and saga state.",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fookiejs/analyze.git"
  },
  "homepage": "https://github.com/fookiejs/analyze#readme",
  "bugs": {
    "url": "https://github.com/fookiejs/analyze/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "typecheck:all": "tsc -p tsconfig.lint.json --noEmit",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "peerDependencies": {
    "@fookiejs/core": ">=0.2.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fookiejs/core": "^0.2.4",
    "@fookiejs/eslint-plugin": "^0.1.9",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "pg": "^8.22.0",
    "prettier": "^3.8.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
